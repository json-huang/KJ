<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="KJ.WinUI.Hosting.ExternalWindowHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="240"
    MinHeight="160">
    <Grid x:Name="Root" Background="#FF0B1118">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="ToolbarPanel"
            Grid.Row="0"
            Padding="8,6"
            Background="#FF111827">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="#FFDCE8F5"
                Text="{x:Bind StatusText, Mode=OneWay}" />
            <Button
                Grid.Column="1"
                MinWidth="64"
                Height="26"
                Padding="10,0"
                Click="OnReleaseClick"
                Content="释放" />
        </Grid>

        <Grid
            x:Name="HostSurface"
            Grid.Row="1"
            Background="Transparent">
            <Border
                x:Name="Placeholder"
                Margin="8"
                Padding="16"
                BorderBrush="#FF3B4756"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="#FFDCE8F5"
                        Text="{x:Bind StatusText, Mode=OneWay}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="#FF8EA0B8"
                        Text="外部窗口将以 Win32 子窗口方式承载" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock
            x:Name="DiagnosticsText"
            Grid.Row="2"
            Padding="8,6"
            FontFamily="Consolas"
            FontSize="11"
            Foreground="#FF8EA0B8"
            Text="{x:Bind Diagnostics, Mode=OneWay}"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
