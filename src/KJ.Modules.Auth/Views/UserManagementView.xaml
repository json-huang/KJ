<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="KJ.Modules.Auth.Views.UserManagementView"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="22" Text="用户管理" Margin="0,0,0,16" />

        <!-- 新建用户表单 -->
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,16">
            <TextBox
                Header="用户名"
                PlaceholderText="输入用户名"
                Text="{Binding NewUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox
                Header="邮箱"
                PlaceholderText="输入邮箱"
                Text="{Binding NewEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <PasswordBox
                Header="密码"
                PasswordChanged="PasswordBox_OnPasswordChanged" />
            <Button
                HorizontalAlignment="Stretch"
                Content="创建用户"
                Command="{Binding CreateUserCommand}" />
        </StackPanel>

        <!-- 用户列表 -->
        <ListView Grid.Row="2" ItemsSource="{Binding Users}" SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="160" />
                            <ColumnDefinition Width="Auto" MinWidth="200" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Username}" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Email}" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <Button
                            Grid.Column="3"
                            Content="删除"
                            Command="{Binding DataContext.DeleteUserCommand, ElementName=RootPage}"
                            CommandParameter="{Binding}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 错误信息与刷新 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
            <TextBlock
                Foreground="DarkRed"
                MinHeight="20"
                VerticalAlignment="Center"
                Text="{Binding ErrorMessage}"
                TextWrapping="WrapWholeWords" />
            <Button
                HorizontalAlignment="Right"
                Content="刷新"
                Command="{Binding LoadUsersCommand}" />
        </StackPanel>
    </Grid>
</Page>
