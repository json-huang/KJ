<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="KJ.Modules.Auth.Views.RoleManagementView"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="22" Text="角色管理" Margin="0,0,0,16" />

        <!-- 新建角色表单 -->
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,16">
            <TextBox
                Header="角色名称"
                PlaceholderText="输入角色名称"
                Text="{Binding NewRoleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                HorizontalAlignment="Stretch"
                Content="创建角色"
                Command="{Binding CreateRoleCommand}" />
        </StackPanel>

        <!-- 角色列表 -->
        <ListView Grid.Row="2" ItemsSource="{Binding Roles}" SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" />
                        <Button
                            Grid.Column="1"
                            Content="删除"
                            Command="{Binding DataContext.DeleteRoleCommand, ElementName=RootPage}"
                            CommandParameter="{Binding}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 错误信息与刷新 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
            <TextBlock
                Foreground="DarkRed"
                MinHeight="20"
                VerticalAlignment="Center"
                Text="{Binding ErrorMessage}"
                TextWrapping="WrapWholeWords" />
            <Button
                HorizontalAlignment="Right"
                Content="刷新"
                Command="{Binding LoadRolesCommand}" />
        </StackPanel>
    </Grid>
</Page>
