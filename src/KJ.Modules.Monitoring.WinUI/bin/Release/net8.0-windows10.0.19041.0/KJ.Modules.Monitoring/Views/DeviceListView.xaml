<?xml version="1.0" encoding="UTF-8" ?>
<Page x:ConnectionId='1'
    x:Class="KJ.Modules.Monitoring.Views.DeviceListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:KJ.Modules.Monitoring.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
                     >
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility" />
    </Page.Resources>
    <Grid Padding="24" MaxWidth="1100">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock FontSize="22" Text="设备列表" />
                <TextBlock Opacity="0.8" Text="数据库基线 + 本地筛选；状态列支持实时覆盖层（预留）。" />
            </StackPanel>

            <Button
                Grid.Column="1"
                MinWidth="92"
                HorizontalAlignment="Right"
                Command="{Binding RefreshCommand}"
                Content="刷新" />
        </Grid>

        <!-- Search + indicators -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                PlaceholderText="搜索：名称 / 类型 / Endpoint / 状态"
                Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ProgressRing
                Grid.Column="1"
                Width="18"
                Height="18"
                Margin="12,0,0,0"
                IsActive="{Binding IsLoading}"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- Error -->
        <Border
            Grid.Row="2"
            Margin="0,0,0,12"
            Padding="12,10"
            Background="#121518"
            BorderBrush="#33424A"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Foreground="#FFF97316"
                    Text="{Binding ErrorMessage}"
                    TextWrapping="WrapWholeWords" />

                <Button
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}"
                    Content="重试" />
            </Grid>
        </Border>

        <!-- Table -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- Header row -->
            <Grid
                Padding="10,8"
                Background="#FF0B0F14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.5*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="名称" Opacity="0.85" />
                <TextBlock Grid.Column="1" Text="类型" Opacity="0.85" />
                <TextBlock Grid.Column="2" Text="Endpoint" Opacity="0.85" />
                <TextBlock Grid.Column="3" Text="状态" Opacity="0.85" />
                <TextBlock Grid.Column="4" Text="最近连接" Opacity="0.85" />
            </Grid>

            <ListView
                Grid.Row="1"
                ItemsSource="{Binding Items}"
                HorizontalContentAlignment="Stretch"
                SelectionMode="Single"
                BorderThickness="0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="40" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            Padding="10,8"
                            Background="#FF0E1319"
                            BorderBrush="#221F2933"
                            BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1.5*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Type}" Opacity="0.9" />
                            <TextBlock Grid.Column="2" Text="{Binding Endpoint}" Opacity="0.9" />

                            <Border
                                Grid.Column="3"
                                Padding="8,2"
                                CornerRadius="10"
                                Background="{Binding StateBrush}"
                                HorizontalAlignment="Left">
                                <TextBlock
                                    Text="{Binding StateText}"
                                    FontSize="12"
                                    Foreground="#FF0B0F14"
                                    FontWeight="SemiBold" />
                            </Border>

                            <TextBlock Grid.Column="4" Text="{Binding LastConnectedText}" Opacity="0.9" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Empty state -->
            <Grid
                Grid.Row="1"
                Background="Transparent"
                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <TextBlock Text="没有匹配的设备" FontSize="16" Opacity="0.9" />
                    <TextBlock Text="尝试调整搜索条件，或点击刷新重新加载。" Opacity="0.7" />
                    <Button Command="{Binding RefreshCommand}" Content="刷新" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>


