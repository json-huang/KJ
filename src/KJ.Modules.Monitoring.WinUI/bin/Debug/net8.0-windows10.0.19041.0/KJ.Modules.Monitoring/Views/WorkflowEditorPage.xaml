<?xml version="1.0" encoding="UTF-8" ?>
<Page x:ConnectionId='1'
    x:Class="KJ.Modules.Monitoring.Views.WorkflowEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
                     
                         >
    <Grid Padding="24" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- Left: canvas -->
        <Grid Grid.Column="0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock FontSize="22" Text="{Binding Title}" />
                    <TextBlock Opacity="0.8" Foreground="{StaticResource KjTextSecondaryBrush}" Text="{Binding SubTitle}" />
                    <TextBlock Opacity="0.85" Foreground="{StaticResource KjTextSecondaryBrush}" Text="{Binding SaveStatusText}" />
                </StackPanel>
                <Button Grid.Column="1" Margin="12,0,0,0" Command="{Binding AddStepCommand}" Content="加一步" Style="{StaticResource Action}" />
                <Button Grid.Column="2" Margin="8,0,0,0" Command="{Binding SaveCommand}" Content="保存" Style="{StaticResource PrimaryAction}" />
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource KjPanelBrush}" BorderBrush="{StaticResource KjStrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                <Grid>
                    <Canvas x:ConnectionId='2' x:Name="LinkLayer" Canvas.ZIndex="0" />
                    <Canvas x:ConnectionId='3' x:Name="NodesLayer" Canvas.ZIndex="10" />

                    <!-- quick visual self-check -->
                    <Border
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Padding="10,6"
                        CornerRadius="8"
                        Background="{StaticResource KjPanel2Brush}"
                        BorderBrush="{StaticResource KjStrokeSubtleBrush}"
                        BorderThickness="1">
                        <TextBlock
                            FontSize="12"
                            Opacity="0.85"
                            Foreground="{StaticResource KjTextSecondaryBrush}"
                            Text="{Binding CanvasDebugText}" />
                    </Border>

                    <!-- Nodes are rendered imperatively into NodesLayer for stable Canvas positioning & drag -->
                </Grid>
            </Border>
        </Grid>

        <!-- Right: properties -->
        <StackPanel Grid.Column="1" Spacing="12">
            <TextBlock FontSize="16" Opacity="0.9" Text="属性" />

            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Opacity="0.8" Foreground="{StaticResource KjTextSecondaryBrush}" Text="流程名" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding WorkflowName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Opacity="0.8" Foreground="{StaticResource KjTextSecondaryBrush}" Text="步骤标题" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StepTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Opacity="0.8" Foreground="{StaticResource KjTextSecondaryBrush}" Text="步骤类型" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding StepKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Opacity="0.8" Foreground="{StaticResource KjTextSecondaryBrush}" Text="ADS AmsNetId" VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding AdsAmsNetId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="例如 192.168.1.10.1.1" />

                <TextBlock Grid.Row="4" Grid.Column="0" Opacity="0.8" Foreground="{StaticResource KjTextSecondaryBrush}" Text="ADS Port" VerticalAlignment="Center" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding AdsAmsPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="通常 851" />

                <TextBlock Grid.Row="5" Grid.Column="0" Opacity="0.8" Foreground="{StaticResource KjTextSecondaryBrush}" Text="Symbol" VerticalAlignment="Center" />
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding AdsSymbol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="例如 MAIN.nSpeed" />

                <TextBlock Grid.Row="6" Grid.Column="0" Opacity="0.8" Foreground="{StaticResource KjTextSecondaryBrush}" Text="数据类型" VerticalAlignment="Center" />
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding AdsDataType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="BOOL/INT/DINT/REAL/STRING…" />
            </Grid>

            <StackPanel Spacing="8">
                <TextBlock Opacity="0.8" Foreground="{StaticResource KjTextSecondaryBrush}" Text="{Binding LinkHint}" TextWrapping="WrapWholeWords" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding SetLinkFromCommand}" Content="设为起点" Style="{StaticResource Action}" />
                    <Button Command="{Binding ConnectToSelectedCommand}" Content="连接" Style="{StaticResource Action}" />
                </StackPanel>
            </StackPanel>

            <Border Padding="12" Background="{StaticResource KjPanelBrush}" BorderBrush="{StaticResource KjStrokeBrush}" BorderThickness="1" CornerRadius="8">
                <TextBlock Opacity="0.75" Foreground="{StaticResource KjTextSecondaryBrush}"
                           Text="提示：当前画布支持拖拽节点 + ‘下一步’连线，并写入 JSON。后续会扩展分支/条件与运行调试。" TextWrapping="WrapWholeWords" />
            </Border>
        </StackPanel>
    </Grid>
</Page>


