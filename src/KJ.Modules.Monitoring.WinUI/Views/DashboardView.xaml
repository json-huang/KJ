<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="KJ.Modules.Monitoring.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:KJ.Modules.Monitoring.ViewModels"
    xmlns:views="using:KJ.Modules.Monitoring.Views"
    xmlns:hosting="using:KJ.WinUI.Hosting"
    mc:Ignorable="d"
    Loaded="OnLoaded">
    <ScrollViewer Padding="24">
        <Grid ColumnSpacing="16" RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.ColumnSpan="2" Spacing="6">
                <TextBlock FontSize="22" Text="Dashboard" />
                <TextBlock
                    Foreground="{StaticResource KjTextSecondaryBrush}"
                    Opacity="0.9"
                    Text="总览：设备在线率、告警态势、关键 Tag、最近事件。"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>

            <!-- KPI row -->
            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource KjPanel2Brush}" BorderBrush="{StaticResource KjStrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                    <StackPanel Spacing="6">
                        <TextBlock Foreground="{StaticResource KjTextMutedBrush}" FontSize="12" Text="设备总数" />
                        <TextBlock FontSize="26" FontWeight="SemiBold" Text="{x:Bind ViewModel.DeviceCount, Mode=OneWay}" />
                        <TextBlock Foreground="{StaticResource KjTextSecondaryBrush}" FontSize="12" Text="{x:Bind ViewModel.SystemStatus, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource KjPanel2Brush}" BorderBrush="{StaticResource KjStrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                    <StackPanel Spacing="6">
                        <TextBlock Foreground="{StaticResource KjTextMutedBrush}" FontSize="12" Text="告警（24h）" />
                        <TextBlock FontSize="26" FontWeight="SemiBold" Text="{x:Bind ViewModel.ActiveAlarmCount, Mode=OneWay}" />
                        <TextBlock Foreground="{StaticResource KjTextSecondaryBrush}" FontSize="12" Text="{x:Bind ViewModel.AlarmSeverityText, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource KjPanel2Brush}" BorderBrush="{StaticResource KjStrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                    <StackPanel Spacing="6">
                        <TextBlock Foreground="{StaticResource KjTextMutedBrush}" FontSize="12" Text="连接质量" />
                        <TextBlock FontSize="26" FontWeight="SemiBold" Text="{x:Bind ViewModel.ConnectionQuality, Mode=OneWay}" />
                        <TextBlock Foreground="{StaticResource KjTextSecondaryBrush}" FontSize="12" Text="设备在线状态" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="{StaticResource KjPanel2Brush}" BorderBrush="{StaticResource KjStrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                    <StackPanel Spacing="6">
                        <TextBlock Foreground="{StaticResource KjTextMutedBrush}" FontSize="12" Text="Tag 采样" />
                        <TextBlock FontSize="26" FontWeight="SemiBold" Text="{x:Bind ViewModel.TagCount, Mode=OneWay}" />
                        <TextBlock Foreground="{StaticResource KjTextSecondaryBrush}" FontSize="12" Text="已注册标签数" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Left: Recent events -->
            <Border Grid.Row="2" Background="{StaticResource KjPanel2Brush}" BorderBrush="{StaticResource KjStrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                <StackPanel Spacing="12">
                    <TextBlock FontWeight="SemiBold" Text="最近事件" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.RecentEvents, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecentEventItem">
                                <Border Background="{StaticResource KjPanelBrush}" BorderBrush="{StaticResource KjStrokeSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource KjPanel2Brush}" BorderBrush="{StaticResource KjStrokeBrush}" BorderThickness="1" CornerRadius="999" Padding="8,2">
                                            <TextBlock Foreground="{StaticResource KjTextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Text="{x:Bind Type}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Message}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Foreground="{StaticResource KjTextMutedBrush}" FontSize="12" Text="{x:Bind TimeText}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Right: Quick actions + system status -->
            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="16">
                <Border Background="{StaticResource KjPanel2Brush}" BorderBrush="{StaticResource KjStrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                    <StackPanel Spacing="10">
                        <TextBlock FontWeight="SemiBold" Text="快速操作" />
                        <Button Style="{StaticResource PrimaryAction}" Content="刷新全量状态" Command="{x:Bind ViewModel.RefreshCommand}" />
                        <Button Style="{StaticResource Action}" Content="查看告警" Command="{x:Bind ViewModel.NavigateToAlarmsCommand}" />
                        <Button Style="{StaticResource Action}" Content="打开设备列表" Command="{x:Bind ViewModel.NavigateToDevicesCommand}" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource KjPanel2Brush}" BorderBrush="{StaticResource KjStrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                    <StackPanel Spacing="10">
                        <TextBlock FontWeight="SemiBold" Text="系统状态" />
                        <Grid ColumnSpacing="10" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource KjTextSecondaryBrush}" Text="数据库" />
                            <Border Grid.Column="1" Background="{StaticResource KjPanelBrush}" BorderBrush="{StaticResource KjStrokeBrush}" BorderThickness="1" CornerRadius="999" Padding="8,2">
                                <TextBlock FontSize="11" Foreground="{StaticResource KjTextSecondaryBrush}" Text="OK" />
                            </Border>

                            <TextBlock Grid.Row="1" Foreground="{StaticResource KjTextSecondaryBrush}" Text="消息总线" />
                            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource KjPanelBrush}" BorderBrush="{StaticResource KjStrokeBrush}" BorderThickness="1" CornerRadius="999" Padding="8,2">
                                <TextBlock FontSize="11" Foreground="{StaticResource KjTextSecondaryBrush}" Text="OK" />
                            </Border>

                            <TextBlock Grid.Row="2" Foreground="{StaticResource KjTextSecondaryBrush}" Text="实时采集" />
                            <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource KjPanelBrush}" BorderBrush="{StaticResource KjStrokeBrush}" BorderThickness="1" CornerRadius="999" Padding="8,2">
                                <TextBlock FontSize="11" Foreground="{StaticResource KjTextSecondaryBrush}" Text="N/A" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Embed zone -->
                <Border
                    x:Name="DashboardEmbedZone"
                    Background="{StaticResource KjPanel2Brush}"
                    BorderBrush="{StaticResource KjStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,12">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="嵌入区" />
                            <ToggleSwitch
                                Grid.Column="1"
                                x:Name="WindowDropToggle"
                                OffContent="拖窗嵌入：关"
                                OnContent="拖窗嵌入：开"
                                Toggled="OnWindowDropToggle" />
                            <Button
                                Grid.Column="2"
                                x:Name="ReleaseEmbeddedButton"
                                Content="释放"
                                IsEnabled="False"
                                Style="{StaticResource Action}"
                                Click="OnReleaseEmbeddedClick" />
                        </Grid>

                        <Border
                            Grid.Row="1"
                            x:Name="EmbedHostBorder"
                            AllowDrop="True"
                            Background="{StaticResource KjPanelBrush}"
                            BorderBrush="{StaticResource KjStrokeSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            DragLeave="OnEmbedZoneDragLeave"
                            DragOver="OnEmbedZoneDragOver"
                            Drop="OnEmbedZoneDrop">
                            <Grid x:Name="EmbedHostSurface">
                                <StackPanel
                                    x:Name="EmbedPlaceholder"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                                    <TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="把插件拖到这里即可嵌入" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Foreground="{StaticResource KjTextSecondaryBrush}"
                                        Opacity="0.85"
                                        Text="从插件中心拖拽插件到此区域松开"
                                        TextAlignment="Center"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                                <Border
                                    x:Name="EmbedDropHighlight"
                                    Background="#2200A3FF"
                                    BorderBrush="{StaticResource KjAccentBrush}"
                                    BorderThickness="2"
                                    CornerRadius="10"
                                    IsHitTestVisible="False"
                                    Opacity="0"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource KjAccentBrush}"
                                        Text="松开鼠标以嵌入插件" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

