<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="KJ.Modules.Monitoring.Views.MonitoringNavigationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:KJ.Modules.Monitoring.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <StackPanel Padding="8,4,8,0" Spacing="12">
        <TextBlock Opacity="0.9" Foreground="{StaticResource KjTextSecondaryBrush}" Text="监控模块" />

        <!-- 概览 -->
        <StackPanel Spacing="6">
            <TextBlock
                FontSize="12"
                Opacity="0.75"
                Foreground="{StaticResource KjTextMutedBrush}"
                Text="概览" />

            <ToggleButton x:Name="DashboardBtn" Tag="Dashboard" Checked="Nav_Checked" PointerEntered="Nav_PointerEntered" PointerExited="Nav_PointerExited" Style="{StaticResource KjNavToggle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource KjAccentBrush}" Visibility="{Binding IsChecked, ElementName=DashboardBtn, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="Dashboard" />
                </Grid>
            </ToggleButton>
        </StackPanel>

        <!-- 设备 -->
        <StackPanel Spacing="6">
            <TextBlock
                FontSize="12"
                Opacity="0.75"
                Foreground="{StaticResource KjTextMutedBrush}"
                Text="设备" />

            <ToggleButton x:Name="DeviceListBtn" Tag="DeviceList" Checked="Nav_Checked" PointerEntered="Nav_PointerEntered" PointerExited="Nav_PointerExited" Style="{StaticResource KjNavToggle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource KjAccentBrush}" Visibility="{Binding IsChecked, ElementName=DeviceListBtn, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="设备列表" />
                </Grid>
            </ToggleButton>

            <ToggleButton x:Name="TagMonitorBtn" Tag="TagMonitor" Checked="Nav_Checked" PointerEntered="Nav_PointerEntered" PointerExited="Nav_PointerExited" Style="{StaticResource KjNavToggle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource KjAccentBrush}" Visibility="{Binding IsChecked, ElementName=TagMonitorBtn, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="Tag 监视" />
                    <!-- 示例徽标：后续接入实时状态/告警数量 -->
                    <Border
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        Padding="8,2"
                        CornerRadius="999"
                        Background="{StaticResource KjPanelBrush}"
                        BorderBrush="{StaticResource KjStrokeBrush}"
                        BorderThickness="1">
                        <TextBlock FontSize="11" Foreground="{StaticResource KjAccentBrush}" Text="LIVE" />
                    </Border>
                </Grid>
            </ToggleButton>
        </StackPanel>

        <!-- 分析 -->
        <StackPanel Spacing="6">
            <TextBlock
                FontSize="12"
                Opacity="0.75"
                Foreground="{StaticResource KjTextMutedBrush}"
                Text="分析" />

            <ToggleButton x:Name="TrendBtn" Tag="TrendChart" Checked="Nav_Checked" PointerEntered="Nav_PointerEntered" PointerExited="Nav_PointerExited" Style="{StaticResource KjNavToggle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource KjAccentBrush}" Visibility="{Binding IsChecked, ElementName=TrendBtn, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="趋势图" />
                </Grid>
            </ToggleButton>
        </StackPanel>
    </StackPanel>
</UserControl>

