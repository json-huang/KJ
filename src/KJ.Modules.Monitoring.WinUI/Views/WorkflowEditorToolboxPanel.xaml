<?xml version="1.0" encoding="UTF-8" ?>

<UserControl

    x:Name="ToolboxRoot"

    x:Class="KJ.Modules.Monitoring.Views.WorkflowEditorToolboxPanel"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    xmlns:vm="using:KJ.Modules.Monitoring.ViewModels"

    mc:Ignorable="d">

    <Grid RowSpacing="10">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />

            <RowDefinition Height="*" />

        </Grid.RowDefinitions>



        <TextBlock

            Grid.Row="0"

            FontSize="16"

            FontWeight="SemiBold"

            Text="工具箱" />

        <TextBlock

            Grid.Row="1"

            FontSize="12"

            Foreground="{StaticResource KjTextMutedBrush}"

            Text="按住模块拖到右侧画布，或点击快速添加。"

            TextWrapping="WrapWholeWords" />



        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">

            <ItemsControl ItemsSource="{Binding ToolboxItems}">

                <ItemsControl.ItemTemplate>

                    <DataTemplate x:DataType="vm:WorkflowToolboxItem">

                        <Border

                            Margin="0,0,0,8"

                            Padding="12,10"

                            Background="{StaticResource KjPanelBrush}"

                            BorderBrush="{StaticResource KjStrokeBrush}"

                            BorderThickness="1"

                            CornerRadius="8"

                            PointerPressed="OnToolboxPointerPressed"

                            Tapped="OnToolboxTapped">

                            <Grid Padding="2,0">

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                </Grid.RowDefinitions>

                                <TextBlock

                                    FontSize="11"

                                    Foreground="{StaticResource KjAccentBrush}"

                                    Text="{x:Bind Category}" />

                                <TextBlock

                                    Grid.Row="1"

                                    FontWeight="SemiBold"

                                    Text="{x:Bind Title}" />

                                <TextBlock

                                    Grid.Row="2"

                                    FontSize="11"

                                    Foreground="{StaticResource KjTextSecondaryBrush}"

                                    Text="{x:Bind Description}"

                                    TextWrapping="WrapWholeWords" />

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </Grid>

</UserControl>

