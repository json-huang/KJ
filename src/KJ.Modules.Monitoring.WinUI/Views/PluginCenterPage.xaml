<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="KJ.Modules.Monitoring.Views.PluginCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:KJ.Modules.Monitoring.Views"
    mc:Ignorable="d"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 置顶通知条：独立占一行，不会被右侧 HWND 浮层盖住 -->
        <Border
            x:Name="EventBanner"
            Grid.Row="0"
            Margin="24,24,24,0"
            Padding="14,10"
            HorizontalAlignment="Stretch"
            Background="#F01E3A5F"
            BorderBrush="{StaticResource KjAccentBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed"
            Canvas.ZIndex="1000">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Name="EventBannerTitle"
                        FontWeight="SemiBold"
                        Foreground="#FFDCE8F5"
                        Text="收到插件信息" />
                    <TextBlock
                        x:Name="EventBannerText"
                        Foreground="#FFDCE8F5"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Click="OnDismissEventBannerClick"
                    Content="关闭"
                    Style="{StaticResource Action}" />
            </Grid>
        </Border>

        <Grid
            Grid.Row="1"
            Padding="24"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock FontSize="22" Text="插件中心" />
                    <TextBlock
                        Foreground="{StaticResource KjTextSecondaryBrush}"
                        Opacity="0.85"
                        Text="连接外部插件并通过 gRPC 通讯；插件界面嵌入右侧区域。"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        x:Name="StatusTextBlock"
                        Foreground="{StaticResource KjTextSecondaryBrush}"
                        Opacity="0.85"
                        Text="等待加载插件清单…" />
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                    <Button Click="OnRefreshClick" Content="刷新" Style="{StaticResource Action}" />
                    <Button Click="OnOpenSelectedClick" Content="连接并嵌入" Style="{StaticResource PrimaryAction}" />
                </StackPanel>

                <Button
                    x:Name="ReleasePluginButton"
                    Grid.Row="2"
                    HorizontalAlignment="Stretch"
                    Click="OnReleasePluginClick"
                    Content="释放插件"
                    IsEnabled="False"
                    Style="{StaticResource Action}" />

                <ListView
                    x:Name="PluginList"
                    Grid.Row="3"
                    BorderBrush="{StaticResource KjStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    SelectionChanged="OnPluginSelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="views:PluginListItem">
                            <Grid Padding="12,10">
                                <StackPanel Spacing="4">
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{StaticResource KjTextSecondaryBrush}"
                                        Text="{x:Bind PluginId}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{StaticResource KjTextSecondaryBrush}"
                                        Text="{x:Bind StateText}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    x:Name="EmbedStatusText"
                    Foreground="{StaticResource KjTextSecondaryBrush}"
                    Opacity="0.9"
                    Text="尚未嵌入插件" />

                <Border
                    Grid.Row="1"
                    Background="{StaticResource KjPanelBrush}"
                    BorderBrush="{StaticResource KjStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid x:Name="PluginHostSurface" Padding="4">
                        <StackPanel
                            x:Name="Placeholder"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="插件显示区" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="{StaticResource KjTextSecondaryBrush}"
                                Opacity="0.85"
                                Text="连接并嵌入后，插件窗口将显示在此区域"
                                TextAlignment="Center"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
