<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="KJ.Modules.Monitoring.Views.PluginCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:KJ.Modules.Monitoring.Views"
    mc:Ignorable="d"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <Grid>
        <Grid
            Padding="24"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock FontSize="22" Text="插件中心" />
                    <TextBlock
                        Foreground="{StaticResource KjTextSecondaryBrush}"
                        Opacity="0.85"
                        Text="将左侧插件拖到右侧嵌入区即可嵌入；也可点击「连接并嵌入」。"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        x:Name="StatusTextBlock"
                        Foreground="{StaticResource KjTextSecondaryBrush}"
                        Opacity="0.85"
                        Text="等待加载插件清单…" />
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                    <Button Click="OnRefreshClick" Content="刷新" Style="{StaticResource Action}" />
                    <Button Click="OnOpenSelectedClick" Content="连接并嵌入" Style="{StaticResource PrimaryAction}" />
                </StackPanel>

                <Button
                    x:Name="ReleasePluginButton"
                    Grid.Row="2"
                    HorizontalAlignment="Stretch"
                    Click="OnReleasePluginClick"
                    Content="释放插件"
                    IsEnabled="False"
                    Style="{StaticResource Action}" />

                <ListView
                    x:Name="PluginList"
                    Grid.Row="3"
                    CanDragItems="True"
                    BorderBrush="{StaticResource KjStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    DragItemsStarting="OnPluginDragItemsStarting"
                    SelectionChanged="OnPluginSelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="views:PluginListItem">
                            <Grid Padding="12,10">
                                <StackPanel Spacing="4">
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{StaticResource KjTextSecondaryBrush}"
                                        Text="{x:Bind PluginId}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{StaticResource KjTextSecondaryBrush}"
                                        Text="{x:Bind StateText}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    x:Name="EmbedStatusText"
                    Foreground="{StaticResource KjTextSecondaryBrush}"
                    Opacity="0.9"
                    Text="尚未嵌入插件" />

                <Border
                    x:Name="EmbedDropZone"
                    Grid.Row="1"
                    AllowDrop="True"
                    Background="{StaticResource KjPanelBrush}"
                    BorderBrush="{StaticResource KjStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    DragLeave="OnEmbedZoneDragLeave"
                    DragOver="OnEmbedZoneDragOver"
                    Drop="OnEmbedZoneDrop">
                    <Grid>
                        <Grid x:Name="PluginHostSurface" Padding="4">
                            <StackPanel
                                x:Name="Placeholder"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="插件嵌入区" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Foreground="{StaticResource KjTextSecondaryBrush}"
                                    MaxWidth="360"
                                    Opacity="0.85"
                                    Text="从左侧列表将插件拖放到此处即可嵌入；释放嵌入不会结束插件进程。"
                                    TextAlignment="Center"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Grid>
                        <Border
                            x:Name="EmbedDropHighlight"
                            Background="#2200A3FF"
                            BorderBrush="{StaticResource KjAccentBrush}"
                            BorderThickness="2"
                            CornerRadius="10"
                            IsHitTestVisible="False"
                            Opacity="0"
                            Visibility="Collapsed">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource KjAccentBrush}"
                                Text="松开鼠标以嵌入插件" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
