{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=mesdb;Uid=root;Pwd=root;SslMode=none;Charset=utf8mb4;"
  },
  "Seed": {
    "AdminEmail": "admin@local",
    "AdminPassword": "ChangeMe123!"
  },
  "Database": {
    "Provider": "MySql",
    "CommandTimeout": 30,
    "MaxRetryCount": 3
  },
  "Identity": {
    "Jwt": {
      "Secret": "change-me-in-production-use-user-secrets",
      "Issuer": "KJ.App",
      "Audience": "KJ.Client",
      "ExpirationMinutes": 60,
      "RefreshExpirationDays": 7
    },
    "Password": {
      "RequiredLength": 8,
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": true
    }
  },
  "Messaging": {
    "Provider": "InMemory",
    "RabbitMQ": {
      "Host": "localhost",
      "Username": "guest",
      "Password": "guest"
    }
  },
  "Devices": {
    "DefaultPollingInterval": 1000,
    "ConnectionTimeout": 5000,
    "MaxRetryCount": 3
  },
  "Alarms": {
    "CheckInterval": 1000,
    "MaxActiveAlarms": 100,
    "NotificationEnabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "KJ": "Debug"
    }
  },
  "Modules": {
    "Items": [
      {
        "Id": "auth",
        "Enabled": true,
        "ModuleType": "KJ.Modules.Auth.AuthModule, KJ.Modules.Auth"
      },
      {
        "Id": "monitoring",
        "Enabled": true,
        "ModuleType": "KJ.Modules.Monitoring.MonitoringModule, KJ.Modules.Monitoring"
      },
      {
        "Id": "config",
        "Enabled": true,
        "ModuleType": "KJ.Modules.Config.ConfigModule, KJ.Modules.Config"
      },
      {
        "Id": "alarm",
        "Enabled": true,
        "ModuleType": "KJ.Modules.Alarm.AlarmModule, KJ.Modules.Alarm"
      },
      {
        "Id": "reporting",
        "Enabled": true,
        "ModuleType": "KJ.Modules.Reporting.ReportingModule, KJ.Modules.Reporting"
      }
    ]
  }
}
