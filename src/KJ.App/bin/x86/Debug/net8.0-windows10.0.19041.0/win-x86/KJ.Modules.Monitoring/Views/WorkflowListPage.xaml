<?xml version="1.0" encoding="UTF-8" ?>
<Page x:ConnectionId='1'
    x:Class="KJ.Modules.Monitoring.Views.WorkflowListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
                     >
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock FontSize="22" Text="流程列表" />
                <TextBlock Opacity="0.8" Foreground="{StaticResource KjTextSecondaryBrush}" Text="本地 JSON 存储（LocalAppData\\KJ\\workflows）。" />
            </StackPanel>

            <Button Grid.Column="1" Margin="12,0,0,0" Command="{Binding NewCommand}" Content="新建" Style="{StaticResource PrimaryAction}" />
            <Button Grid.Column="2" Margin="8,0,0,0" Command="{Binding RefreshCommand}" Content="刷新" Style="{StaticResource Action}" />
        </Grid>

        <ListView x:ConnectionId='2'
            x:Name="WorkflowList"
            Grid.Row="1"
            ItemsSource="{Binding Items}"
            SelectedItem="{Binding Selected, Mode=TwoWay}"
            HorizontalContentAlignment="Stretch"
            BorderThickness="0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12,10" Background="{StaticResource KjPanel2Brush}" BorderBrush="{StaticResource KjStrokeSubtleBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="16" />
                            <TextBlock Opacity="0.75" Foreground="{StaticResource KjTextSecondaryBrush}" Text="{Binding SubTitle}" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding DataContext.OpenSelectedCommand, ElementName=WorkflowList}" Content="打开" Style="{StaticResource Action}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>


