<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="KJ.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <NavigationView x:ConnectionId='2'
        x:Name="RootNav"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
                                         
        PaneDisplayMode="Left">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="概览" IsSelected="True" Tag="home">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="监控" Tag="monitoring">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="SwitchApps" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="配置" Tag="config">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="报警" Tag="alarm">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Important" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="报表" Tag="reporting">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Document" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.PaneFooter>
            <StackPanel Padding="12,0,12,16" Spacing="10">
                <TextBlock
                    Opacity="0.9"
                    Style="{StaticResource MyLabel}"
                    Text="{Binding WelcomeText}"
                    TextWrapping="WrapWholeWords" />
                <TextBlock
                    FontSize="12"
                    Opacity="0.75"
                    Style="{StaticResource MyLabel}"
                    Text="{Binding PermissionHint}"
                    TextWrapping="WrapWholeWords" />
                <Button
                    HorizontalAlignment="Stretch"
                    Command="{Binding AboutCommand}"
                    Content="关于"
                    Style="{StaticResource Action}" />
                <Button
                    HorizontalAlignment="Stretch"
                    Command="{Binding LogoutCommand}"
                    Content="退出登录"
                    Style="{StaticResource Action}" />
            </StackPanel>
        </NavigationView.PaneFooter>
        <ContentControl x:ConnectionId='3' x:Name="ModuleRegionHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </NavigationView>
</Page>

