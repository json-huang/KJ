<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="KJ.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:prism="using:Prism.Navigation.Regions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Background="{StaticResource KjBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：模块导航区域（文档 §6：Regions.MainNavigation） -->
        <Grid Background="{StaticResource KjPanelBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Padding="16,16,16,12" Spacing="8">
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="KJ" />
                <TextBlock
                    Opacity="0.9"
                    Style="{StaticResource KjSecondaryText}"
                    Text="{Binding WelcomeText}"
                    TextWrapping="WrapWholeWords" />
                <TextBlock
                    FontSize="12"
                    Opacity="0.75"
                    Style="{StaticResource KjMutedText}"
                    Text="{Binding PermissionHint}"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Padding="8,0,8,8">
                <StackPanel
                    x:Name="MainNavigationHost"
                    HorizontalAlignment="Stretch"
                    Spacing="4" />
            </ScrollViewer>

            <StackPanel Grid.Row="2" Padding="16,12,16,16" Spacing="10">
                <Button
                    HorizontalAlignment="Stretch"
                    Command="{Binding AboutCommand}"
                    Content="关于"
                    Style="{StaticResource Action}" />
                <Button
                    HorizontalAlignment="Stretch"
                    Command="{Binding LogoutCommand}"
                    Content="退出登录"
                    Style="{StaticResource Action}" />
            </StackPanel>
        </Grid>

        <!-- 右侧：内容区域（文档 §6：Regions.MainContent） -->
        <Border Grid.Column="1" Background="{StaticResource KjBackgroundBrush}">
            <ContentControl
                x:Name="MainContentRegionHost"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                prism:RegionManager.RegionName="MainContent" />
        </Border>
    </Grid>
</Page>
