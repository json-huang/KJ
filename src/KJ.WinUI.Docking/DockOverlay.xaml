<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="KJ.WinUI.Docking.DockOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False"
    Visibility="Collapsed">
    <Grid>
        <Border
            x:Name="PreviewBorder"
            Margin="8"
            Background="#263B80D9"
            BorderBrush="#FF4EA3FF"
            BorderThickness="2"
            CornerRadius="2"
            Visibility="Collapsed" />

        <Grid
            Width="120"
            Height="120"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Border
                Background="#F01E2733"
                BorderBrush="#FF5A6B7F"
                BorderThickness="1"
                CornerRadius="3" />
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="LeftGuide"
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="3"
                    Background="#FF2B6EA6"
                    BorderBrush="#FF79B8F5"
                    BorderThickness="1"
                    CornerRadius="2"
                    Opacity="0.75">
                    <FontIcon FontSize="14" Glyph="&#xE76B;" />
                </Border>
                <Border
                    x:Name="RightGuide"
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="3"
                    Background="#FF2B6EA6"
                    BorderBrush="#FF79B8F5"
                    BorderThickness="1"
                    CornerRadius="2"
                    Opacity="0.75">
                    <FontIcon FontSize="14" Glyph="&#xE76C;" />
                </Border>
                <Border
                    x:Name="BottomGuide"
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="3"
                    Background="#FF2B6EA6"
                    BorderBrush="#FF79B8F5"
                    BorderThickness="1"
                    CornerRadius="2"
                    Opacity="0.75">
                    <FontIcon FontSize="14" Glyph="&#xE74B;" />
                </Border>
                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="3"
                    Background="#FF111827"
                    BorderBrush="#FF5A6B7F"
                    BorderThickness="1"
                    CornerRadius="2">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="#FFDCE8F5" Text="Dock" />
                </Border>
            </Grid>
        </Grid>

        <Border
            x:Name="LeftEdgeGuide"
            Width="34"
            Height="72"
            Margin="16,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Background="#F01E2733"
            BorderBrush="#FF5A6B7F"
            BorderThickness="1"
            CornerRadius="3">
            <FontIcon Foreground="#FF79B8F5" Glyph="&#xE76B;" />
        </Border>

        <Border
            x:Name="RightEdgeGuide"
            Width="34"
            Height="72"
            Margin="0,0,16,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Background="#F01E2733"
            BorderBrush="#FF5A6B7F"
            BorderThickness="1"
            CornerRadius="3">
            <FontIcon Foreground="#FF79B8F5" Glyph="&#xE76C;" />
        </Border>

        <Border
            x:Name="BottomEdgeGuide"
            Width="72"
            Height="34"
            Margin="0,0,0,16"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="#F01E2733"
            BorderBrush="#FF5A6B7F"
            BorderThickness="1"
            CornerRadius="3">
            <FontIcon Foreground="#FF79B8F5" Glyph="&#xE74B;" />
        </Border>

        <TextBlock
            Margin="0,154,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontWeight="SemiBold"
            Foreground="#FFDCE8F5"
            Text="{x:Bind Hint, Mode=OneWay}" />
    </Grid>
</UserControl>
