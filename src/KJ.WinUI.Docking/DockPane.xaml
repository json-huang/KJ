<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="KJ.WinUI.Docking.DockPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    MinWidth="220"
    MinHeight="160">
    <UserControl.Resources>
        <Style x:Key="DockHeaderBtn" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="BorderBrush" Value="#223B4756" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Border
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="#FF1F2933"
        BorderBrush="#FF3B4756"
        BorderThickness="1"
        CornerRadius="2">
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="HeaderBar"
                Grid.Row="0"
                Padding="8,0,4,0"
                Background="#FF111827">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#FFDCE8F5"
                    Text="{x:Bind Title, Mode=OneWay}" />

                <Button
                    Grid.Column="1"
                    Style="{StaticResource DockHeaderBtn}"
                    Click="OnAutoHideClick"
                    ToolTipService.ToolTip="自动隐藏">
                    <FontIcon FontSize="13" Foreground="#FFDCE8F5" Glyph="&#xE718;" />
                </Button>

                <Button
                    Grid.Column="2"
                    Style="{StaticResource DockHeaderBtn}"
                    Click="OnFloatClick"
                    ToolTipService.ToolTip="浮动">
                    <FontIcon FontSize="13" Foreground="#FFDCE8F5" Glyph="&#xE8A7;" />
                </Button>

                <Button
                    Grid.Column="3"
                    Style="{StaticResource DockHeaderBtn}"
                    Background="#26EF4444"
                    BorderBrush="#33EF4444"
                    Click="OnCloseClick"
                    ToolTipService.ToolTip="关闭">
                    <FontIcon FontSize="12" Foreground="#FFFEE2E2" Glyph="&#xE711;" />
                </Button>
            </Grid>

            <ContentPresenter
                x:Name="ContentHost"
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Padding="12,8,12,12" />

            <!-- resize grip (floating) -->
            <Thumb
                x:Name="ResizeGrip"
                Grid.Row="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Width="18"
                Height="18"
                Margin="0,0,6,6"
                DragDelta="OnResizeGripDragDelta"
                Background="#22000000">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <Border
                                Background="Transparent"
                                BorderBrush="#553B82F6"
                                BorderThickness="1"
                                CornerRadius="3" />
                            <Path
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="#AA93C5FD"
                                Data="M 2 10 L 10 2 L 10 4 L 4 10 Z" />
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</UserControl>
