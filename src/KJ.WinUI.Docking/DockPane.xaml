<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="KJ.WinUI.Docking.DockPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    MinWidth="220"
    MinHeight="160">
    <Border
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="#FF1F2933"
        BorderBrush="#FF3B4756"
        BorderThickness="1"
        CornerRadius="2">
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="HeaderBar"
                Grid.Row="0"
                Padding="8,0,4,0"
                Background="#FF111827">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#FFDCE8F5"
                    Text="{x:Bind Title, Mode=OneWay}" />

                <Button
                    Grid.Column="1"
                    Width="24"
                    Height="22"
                    Margin="2,0,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnAutoHideClick"
                    ToolTipService.ToolTip="自动隐藏">
                    <FontIcon FontSize="13" Glyph="&#xE718;" />
                </Button>

                <Button
                    Grid.Column="2"
                    Width="24"
                    Height="22"
                    Margin="1,0,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnFloatClick"
                    ToolTipService.ToolTip="浮动">
                    <FontIcon FontSize="13" Glyph="&#xE8A7;" />
                </Button>

                <Button
                    Grid.Column="3"
                    Width="24"
                    Height="22"
                    Margin="1,0,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnCloseClick"
                    ToolTipService.ToolTip="关闭">
                    <FontIcon FontSize="12" Foreground="#FFE8A0A0" Glyph="&#xE711;" />
                </Button>
            </Grid>

            <ContentPresenter
                x:Name="ContentHost"
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Padding="12,8,12,12" />
        </Grid>
    </Border>
</UserControl>
