<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="KJ.WinUI.Docking.DockHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docking="using:KJ.WinUI.Docking"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">
    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="0" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="RightColumn" Width="320" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition x:Name="BottomRow" Height="0" />
        </Grid.RowDefinitions>

        <ContentPresenter
            x:Name="LeftHost"
            Grid.Row="0"
            Grid.Column="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Margin="0,0,12,0" />

        <ContentPresenter
            x:Name="MainHost"
            Grid.Row="0"
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

        <ContentPresenter
            x:Name="RightHost"
            Grid.Row="0"
            Grid.Column="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Margin="12,0,0,0" />

        <ContentPresenter
            x:Name="BottomHost"
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="0,12,0,0" />

        <Button
            x:Name="CollapsedTab"
            Grid.Row="0"
            Grid.Column="2"
            Width="28"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Background="#FF111827"
            BorderBrush="#FF3B4756"
            BorderThickness="1"
            Click="OnCollapsedTabClick"
            Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                <TextBlock FontWeight="SemiBold" Text="属" />
                <TextBlock FontWeight="SemiBold" Text="性" />
            </StackPanel>
        </Button>

        <docking:DockOverlay
            x:Name="Overlay"
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Grid.ColumnSpan="3" />

        <Canvas
            x:Name="FloatingLayer"
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Background="Transparent"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
